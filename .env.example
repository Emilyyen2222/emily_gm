# 前端可見（會被打包進瀏覽器）
NUXT_PUBLIC_LIFF_ID=

# 以下僅存在於 server 端，切勿加上 NUXT_PUBLIC_ 前綴
# LINE Login Channel 的 Channel ID（驗證 ID Token 用，不是 Messaging API 的）
NUXT_LINE_LOGIN_CHANNEL_ID=
# Messaging API Channel 的憑證
NUXT_LINE_CHANNEL_ACCESS_TOKEN=
NUXT_LINE_CHANNEL_SECRET=
# Supabase：service role key 具完整權限，絕不可外流
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_ROLE_KEY=
# 保護 Cron 端點用的隨機字串，例如 openssl rand -hex 32
NUXT_CRON_SECRET=
